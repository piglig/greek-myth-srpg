{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill trees (data/tables/skill_tree.json)",
  "type": "object",
  "required": [
    "points",
    "trees",
    "default_picks"
  ],
  "additionalProperties": false,
  "properties": {
    "points": {
      "type": "integer",
      "minimum": 0
    },
    "trees": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "branch",
            "nodes"
          ],
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string"
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "cost",
                  "desc"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "cost": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  },
                  "trait": {
                    "type": "string"
                  },
                  "skill": {
                    "type": "string"
                  },
                  "parent": {"type": "string"},
                  "support": {
                    "type": "object",
                    "description": "a hired hero's tree: how much this step adds to his one move",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "power": {"type": "integer"},
                      "max_range": {"type": "integer"},
                      "cooldown": {"type": "integer"},
                      "stagger_bonus": {"type": "integer"},
                      "knockback": {"type": "integer"}
                    }
                  },
                  "desc": {
                    "type": "string"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "trait"
                    ]
                  },
                  {
                    "required": [
                      "skill"
                    ]
                  },
                  {"required": ["support"]}
                ]
              }
            }
          }
        }
      }
    },
    "default_picks": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    }
  }
}
